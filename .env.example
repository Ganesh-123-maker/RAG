# Agentic RAG Knowledge Assistant -- environment template.
# Copy to .env (repo root) for docker compose, or set these in the
# Render dashboard / Vercel project settings for production. Never
# commit a real .env -- .gitignore covers .env, .env.local,
# .env.production and .env.staging. Every value below is a safe
# placeholder; replace the ones marked REQUIRED with real secrets.
#
# REQUIRED = the app will not start (or will not work) without it.
# OPTIONAL = has a safe default in app/core/config.py; set only to change it.

# ── LLM provider (REQUIRED) ─────────────────────────────────────────────
# OPENAI_API_KEY is REQUIRED (no default). Put the provider's key here
# -- the setting name is historical; the same key field carries the
# key for whichever OpenAI-compatible provider LLM_BASE_URL points at.
OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_REAL_KEY
# OPTIONAL: OpenAI-compatible base URL. Unset = the real OpenAI API.
# Set for a free-tier provider, e.g. Gemini:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# or Groq:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_BASE_URL=
# OPTIONAL: separate embeddings provider. Unset = embeddings use the
# same client/key/endpoint as chat. Set BOTH when chat and embeddings
# come from different providers (e.g. Groq has no embeddings API, so
# chat via Groq + embeddings via OpenRouter).
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# OPTIONAL: model names. Defaults are OpenAI's; when LLM_BASE_URL
# points at another provider, set these to that provider's model
# names (e.g. Gemini: gemini-3.5-flash-lite / gemini-embedding-001).
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# OPTIONAL: embedding dimensions, 1..3072 (validated). Must match the
# embedding model's output; 3072 is text-embedding-3-large's native
# size and gemini-embedding-001's default. Changing it requires
# re-creating the Qdrant collection (vectors are stored at this size).
OPENAI_EMBEDDING_DIMENSIONS=3072

# ── Auth (REQUIRED in production) ───────────────────────────────────────
# JWT_SECRET_KEY: REQUIRED in production (startup fails without it).
# In development an unset key falls back to a well-known dev-only
# value -- never deploy with ENVIRONMENT=development + no secret.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS
# OPTIONAL: JWT algorithm and token lifetimes.
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (REQUIRED in production; local default is SQLite) ─────────
# Production: PostgreSQL. Render's fromDatabase URL uses the
# postgres:// scheme -- substitute postgresql+asyncpg:// (see
# docs/DEPLOYMENT.md); docker compose already builds the right URL.
DATABASE_URL=postgresql+asyncpg://raguser:ragpassword@localhost:5432/ragdb
# OPTIONAL: compose-only Postgres settings (the container, not the app).
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Vector store (REQUIRED) ─────────────────────────────────────────────
# Local/compose: QDRANT_HOST=localhost (host) or qdrant (compose),
# port 6333, no API key. Qdrant Cloud: host = your cluster URL
# WITHOUT https://, port 443 (entrypoint.sh then uses https),
# QDRANT_API_KEY set as a secret.
# WARNING: the local default is an in-memory Qdrant (QDRANT_HOST
# ":memory:") only for tests; a production Qdrant must be persistent
# (Qdrant Cloud or the qdrant_data volume in compose). With a volatile
# store, a backend restart wipes all vectors while the DB still says
# "ready" -- Phase 2's startup reconcile re-indexes them, but a
# persistent store is still required for production.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_chunks
QDRANT_API_KEY=

# ── Uploads & chunking (OPTIONAL) ────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# ── Retrieval & generation (OPTIONAL) ────────────────────────────────────
RETRIEVAL_TOP_K=5
RETRIEVAL_FETCH_K=20
RETRIEVAL_SIMILARITY_THRESHOLD=0.30
RETRIEVAL_GRADE_THRESHOLD=0.50
RETRIEVAL_COVERAGE_THRESHOLD=0.50
MMR_LAMBDA=0.7
MAX_CONTEXT_TOKENS=6000
HISTORY_MAX_TOKENS=2000
CHAT_MAX_TOKENS=1000

# ── Rate limits, quotas, lockout, circuit breaker (OPTIONAL) ────────────
# RATE_LIMIT_ENABLED: unset = on everywhere except ENVIRONMENT=test.
# Set false only to disable limits deliberately (not recommended).
# RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_MINUTE=30
DAILY_CHAT_REQUESTS=200
DAILY_TOKEN_BUDGET_EST=200000
LOGIN_MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
INGESTION_MAX_ATTEMPTS=2

# ── Observability (OPTIONAL) ────────────────────────────────────────────
# SENTRY_DSN: unset = Sentry disabled (no-op); no spans/errors leave
# the process without it.
SENTRY_DSN=

# ── Environment & CORS (OPTIONAL, but REQUIRED to set correctly) ────────
ENVIRONMENT=development
# JSON list or comma-separated list. Production startup REJECTS '*'
# (credentials are allowed). Set to the real frontend origin(s).
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ── Frontend (OPTIONAL; only for the Next.js service) ───────────────────
# BACKEND_URL is the server-side rewrite target for /api (see
# frontend/next.config.js); the browser never calls the backend
# directly, so no API key ever reaches the frontend. In compose it is
# http://backend:8000; locally it defaults to http://localhost:8000.
# NEXT_PUBLIC_API_URL is intentionally empty (same-origin proxy).
# BACKEND_URL=http://localhost:8000
