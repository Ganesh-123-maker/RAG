# ─────────────────────────────────────────────────────────────────────────────
# Agentic RAG Knowledge Assistant — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the required values:
#   cp .env.example .env
#
# Required variables are marked with [REQUIRED].
# All others have sensible defaults and can be left as-is for local development.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI ───────────────────────────────────────────────────────────────────
# [REQUIRED] Your OpenAI API key — must have access to:
#   - text-embedding-3-large  (embeddings)
#   - gpt-4o                  (chat completions)
OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_REAL_OPENAI_KEY

# Optional: override the default models or embedding dimensions
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072
OPENAI_CHAT_MODEL=gpt-4o

# ── JWT Auth ─────────────────────────────────────────────────────────────────
# [REQUIRED] Random secret for signing JWT tokens — minimum 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ─────────────────────────────────────────────────────────────────
# For local development without Docker, SQLite works out of the box:
#   DATABASE_URL=sqlite+aiosqlite:///./ragdb.sqlite
#
# For Docker / production, use PostgreSQL (docker-compose sets this automatically):
DATABASE_URL=postgresql+asyncpg://raguser:ragpassword@localhost:5432/ragdb

# PostgreSQL credentials (used by docker-compose only — not read by the app directly)
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragdb

# ── Qdrant Vector Database ───────────────────────────────────────────────────
# For local development without Docker, run Qdrant separately or use in-memory mode:
#   QDRANT_HOST=:memory:   (no persistence — data lost on restart)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_chunks

# ── File Upload ───────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ── RAG Pipeline Tuning ──────────────────────────────────────────────────────
# Chunk size in tokens (cl100k_base tokenizer — same as GPT-4o)
CHUNK_SIZE_TOKENS=512
# Overlap between consecutive chunks — prevents facts from being split at boundaries
CHUNK_OVERLAP_TOKENS=64
# Number of chunks to retrieve per query
RETRIEVAL_TOP_K=5

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
# JSON array of allowed CORS origins for the API
BACKEND_CORS_ORIGINS=["http://localhost:3000"]