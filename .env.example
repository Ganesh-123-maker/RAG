OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_REAL_OPENAI_KEY
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072
OPENAI_CHAT_MODEL=gpt-4o

JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=postgresql+asyncpg://raguser:ragpassword@localhost:5432/ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragdb

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_chunks
# For Qdrant Cloud: set QDRANT_HOST to your cluster URL (without https://) and provide QDRANT_API_KEY
QDRANT_API_KEY=

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
RETRIEVAL_TOP_K=5

ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
# Phase E hardening (defaults in app/core/config.py; only set to change)
# RATE_LIMIT_ENABLED= (unset = on except ENVIRONMENT=test)
# AUTH_RATE_LIMIT_PER_MINUTE=10
# UPLOAD_RATE_LIMIT_PER_MINUTE=10
# CHAT_RATE_LIMIT_PER_MINUTE=30
# DAILY_CHAT_REQUESTS=200
# DAILY_TOKEN_BUDGET_EST=200000
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOCKOUT_MINUTES=15
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
# INGESTION_MAX_ATTEMPTS=2
# SENTRY_DSN= (unset = Sentry disabled, no-op)
